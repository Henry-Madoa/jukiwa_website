# Copy to .env.local and fill in. Never commit .env.local — see .gitignore.
#
# DATABASE_URL may point at the same PostgreSQL server the lending system uses: every table this
# project owns is prefixed `web_` and the two share no table names — but a database of its own is
# better, and is the whole point of running the website as a separate application. To move it:
# create an empty database, change the name in the URL below, and run `pnpm db:setup` against it.
DATABASE_URL="postgresql://user:password@host:5432/Jukiwa_Website?sslmode=require"

# Cloudinary — every image the admin uploads is stored and delivered from here.
CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=jukiwa_website

# The first administrator, created by `pnpm db:setup` on an empty database.
ADMIN_NAME=Website Administrator
ADMIN_EMAIL=admin@jukiwa.co.ke
ADMIN_PASSWORD=change-this-password

# The site's own address, used for canonical URLs, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where "Customer portal" points, if Jukiwa Credit runs one. This is the ONE connection between the
# website and the lending system, and it is a hyperlink — nothing more. Leave empty to hide it.
NEXT_PUBLIC_PORTAL_URL=
